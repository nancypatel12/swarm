NEBIUS_API_KEY=
TAVILY_API_KEY=

# Model ids from Token Factory. Run `.venv/bin/python scripts/smoke.py` to list the NVIDIA ones.
NEMOTRON_NANO=
NEMOTRON_SUPER=
NEMOTRON_ULTRA=

# Optional
# Newest papers read per run, from the last six months.
SWARM_PAPERS=80
SWARM_CONCURRENCY=64
# Spending limits for a public demo. A run is about 130,000 tokens. Spend is kept on disk, so restarts don't reset it.
SWARM_MAX_RUNS_PER_HOUR=6
SWARM_RUNS_PER_VISITOR=3
SWARM_DAILY_TOKENS=1000000
SWARM_TOTAL_TOKENS=20000000
# 1 turns off new runs at once; examples and saved links keep working.
SWARM_PAUSED=0
# 1 only behind a proxy you control, so visitors are told apart by the address it forwards.
SWARM_TRUST_PROXY=0
# Where runs are saved. Use a persistent volume when deployed.
SWARM_DATA_DIR=backend/data
# Optional contact address for OpenAlex's faster pool, used when arXiv's API doesn't answer.
# SWARM_CONTACT=
FRONTEND_ORIGINS=http://localhost:3000
